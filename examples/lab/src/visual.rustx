use rustx::drawing::{Bounds, Camera, CanvasScene, DrawShape, PathSegment, Primitive, Transform};
use rustx::prelude::*;
use std::rc::Rc;
fn panel() -> Style {
    Style::column()
        .padding(20.)
        .gap(14.)
        .radius(16.)
        .background_token(ColorToken::Surface)
        .color_token(ColorToken::Text)
}
fn action() -> Style {
    Style::row()
        .padding(12.)
        .radius(8.)
        .background_token(ColorToken::Accent)
        .color_token(ColorToken::Background)
        .font_size(14.)
}
#[component]
pub fn VisualEngine(cx: Scope) -> View {
    let theme = cx.context::<ThemeContext>().unwrap().0;
    let scene = Rc::new(
        CanvasScene::new(
            (0..10_000)
                .map(|i| {
                    DrawShape::rect(
                        i + 1,
                        Bounds::new((i % 100) as f64 * 60., (i / 100) as f64 * 48., 48., 34.),
                        if i % 3 == 0 {
                            0x64b5f6
                        } else if i % 3 == 1 {
                            0xb5f36b
                        } else {
                            0xf2ab70
                        },
                    )
                })
                .collect(),
        )
        .unwrap(),
    );
    let camera = cx.signal(Camera::default());
    let left = camera.clone();
    let right = camera.clone();
    let zoom = camera.clone();
    let reset = camera.clone();
    let shown = camera.clone();
    let position = camera.clone();
    let gestures = camera.clone();
    let hit_scene = scene.clone();
    let pick = cx.signal(None::<u64>);
    let pick_shown = pick.clone();
    let list = VirtualListState::new(&cx, 100_000, 32., 320.);
    let next = list.clone();
    let end = list.clone();
    let start = list.clone();
    let range = list.clone();
    let selected = cx.signal(None::<usize>);
    let chosen = selected.clone();
    let rows = selected.clone();
    rustx! {<Column style={Style::column().gap(20.).color_token(ColorToken::Text)}>
        <Text style={Style::column().font_size(34.).small_font_size(26.).color_token(ColorToken::Text)}>{"The shared visual engine"}</Text>
        <Text style={Style::column().color_token(ColorToken::Muted)}>{"Rust layout, Unicode text, bounded lists and a retained drawing surface."}</Text>
        <Button id="theme-toggle" style={action()} on_click={move|_|{let _=theme.update(|t|*t=if *t==Theme::DARK{Theme::LIGHT}else{Theme::DARK});}}>{"Switch theme"}</Button>
        <Div id="engine-dashboard" style={Style::grid(1).gap(16.).at_width(ResponsiveStyle{min_width:700.,columns:Some(3),font_size:None,padding:None,direction:None})}>
            <Column style={panel()}><Text>{"100,000 records"}</Text><Text style={Style::column().font_size(28.).color_token(ColorToken::Accent)}>{"Bounded rows"}</Text><Text>{"Two viewports of overscan per side; one focused row can stay mounted."}</Text></Column>
            <Column style={panel()}><Text>{"10,000 drawing objects"}</Text><Text style={Style::column().font_size(28.).color_token(ColorToken::Accent)}>{"Visible geometry"}</Text><Text>{"Spatial buckets cull the scene before either renderer paints it."}</Text></Column>
            <Column style={panel()}><Text>{"یک موتور، دو مسیر"}</Text><Text id="engine-unicode" style={Style::column().font_size(24.).text_direction(TextDirection::RightToLeft)}>{"سلام RustX — English 123 🦀 🚀"}</Text><Text>{"Bundled Persian/English shaping and monochrome emoji fallback."}</Text></Column>
        </Div>
        <Column style={panel()}><Text style={Style::column().font_size(24.)}>{"Drawing board"}</Text>
            <Row style={Style::row().gap(8.).wrap()}><Button id="board-left" style={action()} on_click={move|_|{let _=left.update(|c|c.pan(120.,0.));}}>{"Pan left"}</Button><Button id="board-right" style={action()} on_click={move|_|{let _=right.update(|c|c.pan(-120.,0.));}}>{"Pan right"}</Button><Button id="board-zoom" style={action()} on_click={move|_|{let _=zoom.update(|c|c.zoom_at(160.,120.,1.25));}}>{"Zoom in"}</Button><Button id="board-reset" style={action()} on_click={move|_|{let _=reset.set(Camera::default());}}>{"Reset camera"}</Button></Row>
            <Text id="board-picked">{move||format!("Selected object: {}",pick_shown.get().map(|n|n.to_string()).unwrap_or_else(||"None yet".into()))}</Text>
            <Text id="camera-state">{move||{let c=position.get();format!("Camera {:.1}, {:.1} · zoom {:.2}",c.x,c.y,c.zoom)}}</Text>
            {move||rustx!{<Canvas id="drawing-board" label="10,000 object drawing board; use pan and zoom controls" drawing={scene.clone()} camera={shown.get()} on_canvas={{let gestures=gestures.clone();let scene=hit_scene.clone();let pick=pick.clone();move|event|{match event{rustx::drawing::CanvasEvent::Pan{dx,dy}=>{let _=gestures.update(|c|c.pan(dx,dy));},rustx::drawing::CanvasEvent::Zoom{x,y,factor}=>{let _=gestures.update(|c|c.zoom_at(x,y,factor));},rustx::drawing::CanvasEvent::Pick{x,y}=>{let _=pick.set(scene.hit(gestures.get(),x,y));}}}}} style={Style::column().height(320.).clip().radius(12.).background(0x0b1018)}/>}}
        </Column>
        <Column style={panel()}><Text style={Style::column().font_size(24.)}>{"Virtual data explorer"}</Text>
            <Row style={Style::row().gap(8.).wrap()}><Button id="rows-start" style={action()} on_click={move|_|start.scroll_to(0.)}>{"First rows"}</Button><Button id="rows-next" style={action()} on_click={move|_|next.scroll_by(320.)}>{"Next rows"}</Button><Button id="rows-end" style={action()} on_click={move|_|end.scroll_to(3_199_680.)}>{"Last rows"}</Button></Row>
            <Text id="row-range">{move||{let r=range.range();format!("Materialized window: {}..{} / 100000",r.start,r.end)}}</Text>
            <Text id="selected-row">{move||format!("Selected record: {}",chosen.get().map(|i|(i+1).to_string()).unwrap_or_else(||"None yet".into()))}</Text>
            {virtual_list(list,move|index|{let selected=rows.clone();rustx!{<Button id={format!("record-{index}")} style={Style::row().padding(4.).height(32.).font_size(14.).background_token(ColorToken::Surface).color_token(ColorToken::Text)} on_click={move|_|{let _=selected.set(Some(index));}}>{format!("Record {:06} · دادهٔ آزمایشی",index+1)}</Button>}})}
        </Column>
    </Column>}
}
// A small public drawing fixture also used by engine conformance examples.
pub fn conformance_scene() -> Rc<CanvasScene> {
    Rc::new(
        CanvasScene::new(vec![
            DrawShape::rect(1, Bounds::new(20., 20., 100., 60.), 0xb5f36b),
            DrawShape {
                id: 2,
                bounds: Bounds::new(150., 20., 80., 80.),
                fill: 0x64b5f6,
                primitive: Primitive::Path {
                    segments: vec![
                        PathSegment::Move(150., 100.),
                        PathSegment::Line(190., 20.),
                        PathSegment::Line(230., 100.),
                        PathSegment::Close,
                    ],
                    stroke: Some((2., 0xffffff)),
                },
                transform: Transform::default(),
            },
            DrawShape {
                id: 3,
                bounds: Bounds::new(20., 130., 300., 55.),
                fill: 0xf1f5ff,
                primitive: Primitive::Text {
                    text: "سلام RustX 🦀".into(),
                    size: 22.,
                },
                transform: Transform::default(),
            },
        ])
        .unwrap(),
    )
}
